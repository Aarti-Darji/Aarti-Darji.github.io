<div class="cv-skills">
  {% for content in data[1] %}
    <div class="cv-skill-category">
      <h6 class="cv-skill-category-title">
        {% if content.icon %}<i class="{{ content.icon }}"></i>{% endif %}
        {{ content.name }}
      </h6>
      <div class="cv-skill-tags">
        {% for item in content.keywords %}
          <span class="cv-skill-tag">{{ item }}</span>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
